---
import User from "./UserBuild.astro";

// Define the type for the component's props
export type Props = {
  Departments: {
    DeptId: number;
    DeptName: string;
    Location: number;
    Employees: {
      EmpId: number;
      FirstName: string;
      LastName: string;
      JobTitle: string;
      IsManager: number;
      PhoneNumber: string;
      CellNumber?: string;
      Extension?: string;
      Email: string;
      LocationId: number;
      DepartmentId: number;
    }[];
  };
};

// Extract the DeptEmps data from props
const { Departments } = Astro.props;
---

<!-- Render a list of departments --><!-- Render the details for a single department and list its employees -->
<div class="department-details">
  <div class="text-xl font-medium mb-4 uppercase text-primary-content tracking-wide">
    {Departments.DeptName}
  </div>
  <ul class="employee-list space-y-2">
    {
      Departments.Employees.map((employee) => (
        <h3>
          <User employees={Departments.Employees} />
        </h3>
      ))
    }
  </ul>
</div>
