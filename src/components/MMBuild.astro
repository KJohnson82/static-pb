---
// Properties of each Metal mart store
export type Props = {
  metalmarts: {
    LocId: number;
    LocName: string;
    LocNum: number;
    Address: string;
    City: string;
    State: string;
    Zipcode?: string;
    PhoneNumber: string;
    FaxNumber: string;
    LocEmail: string;
    Hours: string;
    StoreManager: string;
    AreaManager: string;
  }[];
};

const { metalmarts } = Astro.props;
---

<!-- Render a list of Metal Mart stores -->
<ul class="mt-4 ms-0.5 ">
  {metalmarts.map((metalmart) => (
    <!-- List item for each Metal Mart store -->
    <li class="relative rounded-md shadow-md my-2 py-0 mx-0 transition ease-in duration-150 transform hover:-translate-y-1 hover:scale-100 ">
      <!-- Direct link to the Metal Mart store page -->
      <a href={`/metalmart/${metalmart.LocId}`} class="block px-4 py-4 rounded-lg hover:bg-neutral-content hover:rounded-md hover:text-primary-content transition-colors">
        <div class="flex items-center justify-between">
          <div class="text-xl uppercase font-medium hover:border-transparent tracking-wide text-primary-content">
            {metalmart.LocName}
          </div>
          <!-- Optionally display more information or an icon -->
          <span class="text-sm font-semibold text-gray-500">
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  li:nth-child(odd) {
    background-color: #075985;
  }
  li:nth-child(even) {
    background-color: #398AB9;
  }
</style>